// Mizan — relational model. All money is DECIMAL(18,2); rates are DECIMAL(18,8).
// Every user-owned row carries userId for strict per-user isolation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Currency {
  MAD
  EUR
  USD
}

enum AccountType {
  BANK
  CASH
  SAVINGS
  CUSTOM
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
  DIRECT_DEBIT
  CHEQUE
  MOBILE
  OTHER
}

enum BudgetPeriod {
  MONTHLY
  WEEKLY
}

enum DebtDirection {
  BORROWED
  LENT
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ImportStatus {
  UPLOADED
  PREVIEWED
  IMPORTED
  CANCELLED
  FAILED
}

model User {
  id               String    @id @default(cuid()) @db.VarChar(30)
  email            String    @unique @db.VarChar(191)
  passwordHash     String    @db.VarChar(255)
  name             String    @db.VarChar(80)
  emailVerifiedAt  DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  settings              UserSettings?
  accounts              Account[]
  transactions          Transaction[]
  categories            Category[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  debts                 Debt[]
  recurringTransactions RecurringTransaction[]
  notifications         Notification[]
  attachments           Attachment[]
  refreshTokens         RefreshToken[]
  authTokens            AuthToken[]
  importBatches         ImportBatch[]
  exchangeRates         ExchangeRate[]

  @@map("users")
}

model UserSettings {
  id           String   @id @default(cuid()) @db.VarChar(30)
  userId       String   @unique @db.VarChar(30)
  baseCurrency Currency @default(MAD)
  timezone     String   @default("Africa/Casablanca") @db.VarChar(64)
  locale       String   @default("fr-MA") @db.VarChar(10)
  weekStartsOn Int      @default(1) @db.TinyInt
  budgetAlerts Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Account {
  id                String      @id @default(cuid()) @db.VarChar(30)
  userId            String      @db.VarChar(30)
  name              String      @db.VarChar(60)
  type              AccountType
  currency          Currency    @default(MAD)
  openingBalance    Decimal     @default(0) @db.Decimal(18, 2)
  color             String      @default("#4B3FD1") @db.VarChar(7)
  institution       String?     @db.VarChar(80)
  includeInNetWorth Boolean     @default(true)
  isArchived        Boolean     @default(false)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]          @relation("TxAccount")
  incomingTransfers     Transaction[]          @relation("TxToAccount")
  recurringTransactions RecurringTransaction[] @relation("RecAccount")
  recurringIncoming     RecurringTransaction[] @relation("RecToAccount")
  importBatches         ImportBatch[]

  @@index([userId, isArchived])

  @@map("accounts")
}

model Category {
  id        String       @id @default(cuid()) @db.VarChar(30)
  userId    String       @db.VarChar(30)
  name      String       @db.VarChar(40)
  type      CategoryType
  icon      String       @default("dots") @db.VarChar(30)
  color     String       @default("#7D8590") @db.VarChar(7)
  parentId  String?      @db.VarChar(30)
  key       String?      @db.VarChar(40)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Category?              @relation("Subcategories", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children      Category[]             @relation("Subcategories")
  transactions  Transaction[]
  budgets       Budget[]
  recurring     RecurringTransaction[]

  @@index([userId, type])
  @@index([parentId])

  @@map("categories")
}

model Transaction {
  id             String          @id @default(cuid()) @db.VarChar(30)
  userId         String          @db.VarChar(30)
  type           TransactionType
  /// Always positive. Direction is given by `type`.
  amount         Decimal         @db.Decimal(18, 2)
  /// Currency of `accountId` at creation time.
  currency       Currency
  date           DateTime        @db.Date
  description    String          @db.VarChar(140)
  note           String?         @db.Text
  paymentMethod  PaymentMethod?
  accountId      String          @db.VarChar(30)
  /// Transfers only: destination account, credited amount and the explicit rate used.
  toAccountId    String?         @db.VarChar(30)
  toAmount       Decimal?        @db.Decimal(18, 2)
  toCurrency     Currency?
  exchangeRate   Decimal?        @db.Decimal(18, 8)
  categoryId     String?         @db.VarChar(30)
  /// Rows tied to a debt move balances but are excluded from income/expense reports.
  debtId         String?         @db.VarChar(30)
  recurringId    String?         @db.VarChar(30)
  /// Occurrence date for recurring generation; unique with recurringId to prevent duplicates.
  recurrenceDate DateTime?       @db.Date
  importBatchId  String?         @db.VarChar(30)
  importHash     String?         @db.VarChar(64)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account               @relation("TxAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount    Account?              @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category     Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  debt         Debt?                 @relation(fields: [debtId], references: [id], onDelete: SetNull)
  recurring    RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  importBatch  ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  attachments  Attachment[]
  debtPayment  DebtPayment?
  contribution SavingsContribution?

  @@unique([recurringId, recurrenceDate])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([accountId, date])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([debtId])
  @@index([userId, importHash])

  @@map("transactions")
}

model Budget {
  id         String       @id @default(cuid()) @db.VarChar(30)
  userId     String       @db.VarChar(30)
  name       String       @db.VarChar(60)
  period     BudgetPeriod
  amount     Decimal      @db.Decimal(18, 2)
  currency   Currency     @default(MAD)
  /// Null = overall spending budget.
  categoryId String?      @db.VarChar(30)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])

  @@map("budgets")
}

model SavingsGoal {
  id           String    @id @default(cuid()) @db.VarChar(30)
  userId       String    @db.VarChar(30)
  name         String    @db.VarChar(60)
  targetAmount Decimal   @db.Decimal(18, 2)
  currency     Currency  @default(MAD)
  deadline     DateTime? @db.Date
  icon         String    @default("piggy") @db.VarChar(30)
  color        String    @default("#4B3FD1") @db.VarChar(7)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId])

  @@map("savings_goals")
}

model SavingsContribution {
  id            String   @id @default(cuid()) @db.VarChar(30)
  goalId        String   @db.VarChar(30)
  /// Negative for withdrawals.
  amount        Decimal  @db.Decimal(18, 2)
  date          DateTime @db.Date
  note          String?  @db.VarChar(255)
  transactionId String?  @unique @db.VarChar(30)
  createdAt     DateTime @default(now())

  goal        SavingsGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, date])

  @@map("savings_contributions")
}

model Debt {
  id           String        @id @default(cuid()) @db.VarChar(30)
  userId       String        @db.VarChar(30)
  direction    DebtDirection
  counterparty String        @db.VarChar(80)
  principal    Decimal       @db.Decimal(18, 2)
  currency     Currency      @default(MAD)
  startDate    DateTime      @db.Date
  dueDate      DateTime?     @db.Date
  note         String?       @db.Text
  settledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     DebtPayment[]
  transactions Transaction[]

  @@index([userId, settledAt])

  @@map("debts")
}

model DebtPayment {
  id            String   @id @default(cuid()) @db.VarChar(30)
  debtId        String   @db.VarChar(30)
  amount        Decimal  @db.Decimal(18, 2)
  date          DateTime @db.Date
  note          String?  @db.VarChar(255)
  transactionId String?  @unique @db.VarChar(30)
  createdAt     DateTime @default(now())

  debt        Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([debtId, date])

  @@map("debt_payments")
}

model RecurringTransaction {
  id            String          @id @default(cuid()) @db.VarChar(30)
  userId        String          @db.VarChar(30)
  type          TransactionType
  amount        Decimal         @db.Decimal(18, 2)
  currency      Currency
  description   String          @db.VarChar(140)
  paymentMethod PaymentMethod?
  accountId     String          @db.VarChar(30)
  toAccountId   String?         @db.VarChar(30)
  categoryId    String?         @db.VarChar(30)
  frequency     Frequency
  interval      Int             @default(1)
  startDate     DateTime        @db.Date
  endDate       DateTime?       @db.Date
  nextDate      DateTime        @db.Date
  anchorDay     Int?            @db.TinyInt
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation("RecAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount    Account?      @relation("RecToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, isActive, nextDate])

  @@map("recurring_transactions")
}

model Notification {
  id        String    @id @default(cuid()) @db.VarChar(30)
  userId    String    @db.VarChar(30)
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(120)
  body      String    @db.VarChar(500)
  data      Json?
  /// Prevents the same alert (e.g. budget 75% for a period) from being sent twice.
  dedupeKey String?   @db.VarChar(191)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])

  @@map("notifications")
}

model Attachment {
  id            String   @id @default(cuid()) @db.VarChar(30)
  userId        String   @db.VarChar(30)
  transactionId String   @db.VarChar(30)
  fileName      String   @db.VarChar(255)
  mimeType      String   @db.VarChar(100)
  size          Int
  storageKey    String   @unique @db.VarChar(255)
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])

  @@map("attachments")
}

model RefreshToken {
  id           String    @id @default(cuid()) @db.VarChar(30)
  userId       String    @db.VarChar(30)
  /// SHA-256 of the opaque token; the raw token is never stored.
  tokenHash    String    @unique @db.VarChar(64)
  /// All rotations of one login share a family; reuse of a rotated token revokes the family.
  familyId     String    @db.VarChar(30)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.VarChar(30)
  userAgent    String?   @db.VarChar(255)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])

  @@map("refresh_tokens")
}

model AuthToken {
  id        String        @id @default(cuid()) @db.VarChar(30)
  userId    String        @db.VarChar(30)
  type      AuthTokenType
  tokenHash String        @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])

  @@map("auth_tokens")
}

model ImportBatch {
  id             String       @id @default(cuid()) @db.VarChar(30)
  userId         String       @db.VarChar(30)
  accountId      String       @db.VarChar(30)
  fileName       String       @db.VarChar(255)
  fileType       String       @db.VarChar(10)
  status         ImportStatus @default(UPLOADED)
  rowCount       Int          @default(0)
  importedCount  Int          @default(0)
  duplicateCount Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt])

  @@map("import_batches")
}

model ExchangeRate {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @db.VarChar(30)
  /// 1 unit of `base` = `rate` units of `quote`.
  base      Currency
  quote     Currency
  rate      Decimal  @db.Decimal(18, 8)
  date      DateTime @db.Date
  source    String   @default("manual") @db.VarChar(40)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, base, quote, date])
  @@index([userId, base, quote, date])

  @@map("exchange_rates")
}
