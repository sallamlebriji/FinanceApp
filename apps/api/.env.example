NODE_ENV=development
PORT=4100
# MySQL 8 or MariaDB 10.4+
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3317/personal_finance
SHADOW_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3317/personal_finance_shadow
TEST_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3317/personal_finance_test
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5180
APP_URL=http://localhost:5180
# Server-side only, never exposed to clients (Phase 5)
GEMINI_API_KEY=

# Set to true in production (managed MySQL over TLS)
DB_SSL=false
